# ก็อปไฟล์นี้เป็น .env แล้วใส่ค่าจริง (.env จะไม่ถูก commit เข้า git — ดู .gitignore)

# X-Print-Key สำหรับดึงรายชื่อบ้านจาก SmartPay API (POST /print-batch-by-key) — ขอจากผู้ดูแลระบบ
SMARTPAY_PRINT_KEY=

# ไม่บังคับ — ถ้าตั้งไว้ พิมพ์เสร็จแล้วจะบันทึกประวัติ (POST /print/sticker-batch/log) ให้อัตโนมัติ
# SMARTPAY_ADMIN_JWT=

# ไม่บังคับ — เปิด mock mode ผ่าน .env แทนการพิมพ์ --mock ทุกครั้งก็ได้ (ตั้งเป็น 1 เพื่อเปิด)
# TSC_MOCK=1
